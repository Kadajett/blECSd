{
  "name": "@blecsd/ai",
  "version": "0.6.0",
  "description": "AI-focused widgets for blECSd - conversation, streaming markdown, token tracking, tool use, agent workflow",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/"
  },
  "peerDependencies": {
    "blecsd": ">=0.6.0"
  },
  "devDependencies": {
    "blecsd": "workspace:*",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "engines": { "node": ">=22.0.0" },
  "license": "MIT",
  "author": "Jeremy Stover",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kadajett/blECSd.git",
    "directory": "packages/ai"
  },
  "keywords": ["terminal", "ai", "llm", "conversation", "streaming", "tui", "blecsd"]
}
