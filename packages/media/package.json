{
  "name": "@blecsd/media",
  "version": "0.6.0",
  "description": "Media rendering for blECSd - GIF/PNG parsers, ANSI rendering, image and video widgets",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./gif": {
      "import": "./dist/gif/index.js",
      "types": "./dist/gif/index.d.ts"
    },
    "./overlay": {
      "import": "./dist/overlay/index.js",
      "types": "./dist/overlay/index.d.ts"
    },
    "./png": {
      "import": "./dist/png/index.js",
      "types": "./dist/png/index.d.ts"
    },
    "./render": {
      "import": "./dist/render/index.js",
      "types": "./dist/render/index.d.ts"
    },
    "./widgets/image": {
      "import": "./dist/widgets/image/index.js",
      "types": "./dist/widgets/image/index.d.ts"
    },
    "./widgets/video": {
      "import": "./dist/widgets/video/index.js",
      "types": "./dist/widgets/video/index.d.ts"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/"
  },
  "peerDependencies": {
    "blecsd": ">=0.6.0"
  },
  "devDependencies": {
    "blecsd": "workspace:*",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "engines": { "node": ">=22.0.0" },
  "license": "MIT",
  "author": "Jeremy Stover",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kadajett/blECSd.git",
    "directory": "packages/media"
  },
  "keywords": ["terminal", "media", "gif", "png", "image", "video", "tui", "blecsd"]
}
