{
  "name": "@blecsd/3d",
  "version": "0.6.0",
  "description": "Terminal 3D rendering for blECSd - rasterizer, math, OBJ loader, and multiple backends",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./backends": {
      "import": "./dist/backends/index.js",
      "types": "./dist/backends/index.d.ts"
    },
    "./components": {
      "import": "./dist/components/index.js",
      "types": "./dist/components/index.d.ts"
    },
    "./loaders": {
      "import": "./dist/loaders/index.js",
      "types": "./dist/loaders/index.d.ts"
    },
    "./math": {
      "import": "./dist/math/index.js",
      "types": "./dist/math/index.d.ts"
    },
    "./rasterizer": {
      "import": "./dist/rasterizer/index.js",
      "types": "./dist/rasterizer/index.d.ts"
    },
    "./schemas": {
      "import": "./dist/schemas/index.js",
      "types": "./dist/schemas/index.d.ts"
    },
    "./stores": {
      "import": "./dist/stores/index.js",
      "types": "./dist/stores/index.d.ts"
    },
    "./systems": {
      "import": "./dist/systems/index.js",
      "types": "./dist/systems/index.d.ts"
    },
    "./widgets": {
      "import": "./dist/widgets/viewport3d.js",
      "types": "./dist/widgets/viewport3d.d.ts"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/"
  },
  "peerDependencies": {
    "blecsd": ">=0.6.0"
  },
  "devDependencies": {
    "blecsd": "workspace:*",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "engines": { "node": ">=22.0.0" },
  "license": "MIT",
  "author": "Jeremy Stover",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kadajett/blECSd.git",
    "directory": "packages/3d"
  },
  "keywords": ["terminal", "3d", "tui", "ecs", "rasterizer", "blecsd"]
}
